# Copy to .env. The CRM itself runs without any of these; they matter for the factory stack.

# OpenRouter key used by Hermes (Implement and Ask tabs) and by seed/generate.py.
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017

# local: bare repository in a Docker volume plus the deployer service (no GitHub needed).
DELIVERY_MODE=local

# Ports on the host.
WEB_PORT=8080
PRODUCTION_PORT=8100
PREVIEW_PORT_BASE=8200

# Load the fictional demo dataset into an empty database.
SEED_DEMO_DATA=true
SEED_MODEL=meta-llama/llama-3.1-8b-instruct
